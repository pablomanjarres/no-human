# OS
Thumbs.db

# local-only working notes — drafts, scratch copies, paste targets.
# anything you don't want shipped goes here.
.private/

# Playwright MCP local artifacts
.playwright-mcp/
.env*

# Compiled output must never land beside sources: `tsc` without -p tsconfig.build.json
# writes .js next to .ts, and Vite resolves the packages' .js import specifiers to
# those stale files instead of the TypeScript — tests then silently exercise dead code.
packages/*/src/**/*.js
