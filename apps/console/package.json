{
  "name": "@no-human/console",
  "version": "0.0.1-alpha.0",
  "private": true,
  "type": "module",
  "description": "Cross-brand equivalence console: competitor sensor in, cited SICK equivalent out.",
  "scripts": {
    "sync:landing": "node scripts/sync-landing.mjs",
    "dev": "node scripts/sync-landing.mjs && node scripts/build-catalog.mjs && node scripts/build-consult-catalog.mjs && next dev --port 3200",
    "build": "node scripts/sync-landing.mjs && node scripts/build-catalog.mjs && node scripts/build-consult-catalog.mjs && next build",
    "start": "next start --port 3200",
    "typecheck": "node scripts/build-catalog.mjs && node scripts/build-consult-catalog.mjs && tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:consult-catalog": "node scripts/build-consult-catalog.mjs"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@no-human/consultancy-engine": "workspace:*",
    "@no-human/consultancy-llm": "workspace:*"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  }
}
