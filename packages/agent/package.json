{
  "name": "@no-human/agent",
  "version": "0.0.1-alpha.0",
  "private": true,
  "type": "module",
  "description": "Runtime agent layer: Resolver (messy input to spec vector), Challenger (adversarial validation), consultant mode, and a fully traced orchestrator.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sick-agent": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@no-human/rag": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
