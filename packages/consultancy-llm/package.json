{
  "name": "@no-human/consultancy-llm",
  "version": "0.0.1-alpha.0",
  "private": true,
  "type": "module",
  "description": "Anthropic transport for the consultancy engine. The only place in the repo that calls a model.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@no-human/consultancy-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
