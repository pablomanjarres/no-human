# Copy to .env.local and fill in. Never commit .env.local.
#
# The console renders from the offline corpus and needs none of these to run —
# `pnpm --filter @no-human/console dev` works with this file absent. They are
# the seam for the live agent core.

# Resolver, verifier and challenger agents.
ANTHROPIC_API_KEY=

# Where the extraction swarm writes structured spec rows, and where the solver
# reads them. Defaults to the local fixture set when unset.
SPEC_DB_URL=

# Root of the cached datasheet PDFs. The demo must run with no network, so this
# is a local path, not a URL.
CORPUS_DIR=./corpus

# NOTE: if your key is a MongoDB Atlas key rather than a Voyage AI key (Atlas
# hosts a Voyage gateway), point the base URLs at the gateway — api.voyageai.com
# rejects Atlas keys with "This API key cannot access this endpoint". The gateway
# does proxy /contextualizedembeddings; verified against voyage-context-3.
# VOYAGE_CONTEXT_ENDPOINT=https://ai.mongodb.com/v1
# VOYAGE_RERANK_ENDPOINT=https://ai.mongodb.com/v1
